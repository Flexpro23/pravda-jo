rules_version = '2';

// A teardown is a document about someone else's business, reachable only by an
// unguessable token, and it is written by the operator endpoint alone. Nothing
// in it is ever read from a browser: every path runs server-side through the
// Admin SDK, which bypasses these rules by design.
//
// So this file's whole job is to deny the client SDK outright. If a rule here
// ever needs loosening, that is the signal that a token has been moved into
// client-side code — which would put every prospect's report one enumeration
// away from public.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

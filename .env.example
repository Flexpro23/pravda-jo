# Copy to .env.local for local development. .env*.local is gitignored.
# In production these come from Cloud Secret Manager via apphosting.yaml.

# PRAVDA's own Instagram Professional account id. Business Discovery queries
# always authenticate as us; the prospect is only a parameter.
META_IG_USER_ID=

# Long-lived Page access token. Needs instagram_basic,
# instagram_manage_insights, pages_read_engagement — PLUS ads_read, because the
# Page role came through Business Manager. Without ads_read every call 403s and
# the error does not mention ads.
META_ACCESS_TOKEN=

# Shared secret for POST /api/teardown. Unset means the endpoint is closed.
# Generate: openssl rand -base64 32
OPERATOR_KEY=

# Optional. Defaults to v21.0.
META_API_VERSION=

# Local only. On App Hosting the runtime service account supplies credentials
# automatically and this must stay unset. Single-line JSON.
FIREBASE_SERVICE_ACCOUNT=

# ── Telling somebody a lead arrived ─────────────────────────────────────────

# Khaled's phone. Where "new lead" and "report ready" go. Without it the console
# still composes both messages and shows them, but there is no wa.me link to
# open, so it says so rather than pretending one was sent.
OPERATOR_PHONE=

# ── WhatsApp Cloud API — optional, and honest when absent ───────────────────
# Unset, nothing sends itself: talent bookings and operator notices both fall
# back to a wa.me link the console shows for a human to tap, and the record says
# un-notified. Set all three and they send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# An approved template name. Required for talent (business-initiated, outside a
# 24-hour window); the operator's own notices go as free text.
WHATSAPP_TEMPLATE=

# Copy to .env.local for local development. .env*.local is gitignored.
# In production these come from Cloud Secret Manager via apphosting.yaml.

# PRAVDA's own Instagram Professional account id. Business Discovery queries
# always authenticate as us; the prospect is only a parameter.
META_IG_USER_ID=

# Long-lived Page access token. Needs instagram_basic,
# instagram_manage_insights, pages_read_engagement — PLUS ads_read, because the
# Page role came through Business Manager. Without ads_read every call 403s and
# the error does not mention ads.
META_ACCESS_TOKEN=

# Shared secret for POST /api/teardown. Unset means the endpoint is closed.
# Generate: openssl rand -base64 32
OPERATOR_KEY=

# Signs the operator console's session cookie, and salts the rate limiter's
# hashed keys. Kept separate from OPERATOR_KEY so that signing every operator
# out everywhere is a rotation of this one value rather than a change of the
# password two people have memorised. Falls back to OPERATOR_KEY when unset,
# which works but ties the two together.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Optional. Signs provider (talent) sessions on their own. Falls back to
# SESSION_SECRET, then OPERATOR_KEY — set it so rotating the console's secret
# does not sign every provider out on the morning of a shoot.
TALENT_SESSION_SECRET=

# The only lock on GET /api/cron/read, the sweeper that makes a read a promise
# rather than a hope. Unset means the route is closed — and a closed sweeper
# means a lead whose instance died mid-read stays stuck in `reading` forever.
# Cloud Scheduler sends it as the x-pravda-cron header:
#   gcloud scheduler jobs create http pravda-read-queue \
#     --schedule="* * * * *" --uri="$SITE/api/cron/read" \
#     --http-method=GET --headers="x-pravda-cron=<this value>"
# Generate: openssl rand -base64 32
CRON_SECRET=

# Which handle POST /api/ops/selfcheck asks Meta about when testing whether our
# token is still alive. Ours, or any public professional account — never a
# prospect's, so a liveness check cannot spend a read somebody is waiting for.
# Defaults to `instagram`.
META_SELFCHECK_HANDLE=

# Optional. Defaults to v21.0.
META_API_VERSION=

# Local only. On App Hosting the runtime service account supplies credentials
# automatically and this must stay unset. Single-line JSON.
FIREBASE_SERVICE_ACCOUNT=

# ── Where this deployment lives ─────────────────────────────────────────────

# Everything that names the site absolutely — the sitemap, robots, canonical
# URLs, the user-agent we identify ourselves with when reading a prospect's
# page, and the links inside every notification — reads this. Defaults to the
# App Hosting address, which is a real, reachable origin rather than a domain
# that resolves to nothing. Set it the day the domain is bought; nothing else
# in the code has to change.
NEXT_PUBLIC_SITE_URL=

# Both mailboxes sit on a domain that is not registered yet, so they are
# variables too and move with it.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# ── Telling somebody a lead arrived ─────────────────────────────────────────

# Khaled's phone. Where "new lead" and "report ready" go. Without it the console
# still composes both messages and shows them, but there is no wa.me link to
# open, so it says so rather than pretending one was sent.
OPERATOR_PHONE=

# ── WhatsApp Cloud API — optional, and honest when absent ───────────────────
# Unset, nothing sends itself: talent bookings and operator notices both fall
# back to a wa.me link the console shows for a human to tap, and the record says
# un-notified. Set all three and they send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# An approved template name. Required for talent (business-initiated, outside a
# 24-hour window); the operator's own notices go as free text.
WHATSAPP_TEMPLATE=
# Optional. An approved template for the day-before reminder; absent, the
# reminder goes as free text (only deliverable inside an open 24h window).
WHATSAPP_REMINDER_TEMPLATE=

# ── Telegram — the channel that actually works today ────────────────────────
# WhatsApp free-text to Khaled's own number only sends inside a 24-hour window
# he has to open himself, so operator notices start failing silently after a
# quiet day. A Telegram bot has no window, no business verification and no
# template approval: message @BotFather, take the token, then read the chat id
# from https://api.telegram.org/bot<token>/getUpdates after messaging the bot
# once. Both must be set or the channel is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email notices via Resend — the searchable copy ──────────────────────────
# Third in the cascade, and the only channel still readable next quarter. All
# three are needed; the two addresses sit on a domain that is not registered
# yet, so this stays dormant until it is. NOTIFY_EMAIL_FROM must be a sender
# Resend has verified for that domain.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# ── Cloudflare Turnstile — optional, off by default ─────────────────────────
# The public form is already guarded by a honeypot, a minimum time-on-form and
# two per-IP windows. Set both of these only once abuse is actually observed:
# a challenge costs the visitor a step at the highest-value moment on the site.
# When either is unset the check is skipped entirely.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
